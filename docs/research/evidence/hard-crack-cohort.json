    "cell_source": "previous_runs = [\n    PROJECT_ROOT / \"outputs/experiments\" / name\n    for name in (\"efficientnet_b0\", \"convnext_tiny\", \"swin_t\")\n]\nprevious_runs.append(PROJECT_ROOT / \"outputs/refinement/architecture/convnext_tiny_multiscale\")\nprevious_runs.extend(\n    PROJECT_ROOT / \"outputs/refinement/architecture_search\" / name\n    for name in (\"C1_attention\", \"C2_mil\", \"C3_fpn\", \"C4_eca\", \"C5_queries\", \"C6_asl\")\n)\nprevious_runs.extend(\n    PROJECT_ROOT / \"outputs/refinement/sampling_noise_controls\" / name\n    for name in (\"N1_natural_noise\", \"N2_balanced_clean\", \"N3_natural_clean\")\n)\nexpected_val = [record for record in records if record[\"split\"] == \"val\"]\nexpected_ids = [record[\"id\"] for record in expected_val]\nexpected_labels = np.asarray([record[\"labels\"] for record in expected_val])\ncommon_misses = expected_labels[:, 0].astype(bool)\nprevious_hashes = {}\n\n\ndef file_hash(path):\n    with Path(path).open(\"rb\") as stream:\n        return hashlib.file_digest(stream, \"sha256\").hexdigest()\n\n\nfor directory in previous_runs:\n    run = json.loads((directory / \"run.json\").read_text())\n    if (\n        run.get(\"status\") != \"complete\"\n        or run[\"metadata\"][\"data_fingerprint\"] != prepared[\"data_fingerprint\"]\n        or run[\"class_names\"] != list(CLASS_NAMES)\n    ):\n        raise ValueError(\"Previous results must be complete and match the prepared data\")\n    with np.load(directory / \"validation.npz\", allow_pickle=False) as archive:\n        if (\n            archive[\"ids\"].tolist() != expected_ids\n            or not np.array_equal(archive[\"labels\"], expected_labels)\n            or archive[\"logits\"].shape != expected_labels.shape\n            or not np.isfinite(archive[\"logits\"]).all()\n        ):\n            raise ValueError(\"Previous validation predictions are stale or invalid\")\n        scores = torch.from_numpy(archive[\"logits\"]).sigmoid().numpy()[:, 0]\n    common_misses &= scores < run[\"metrics\"][\"thresholds\"][0]\n    for filename in (\"run.json\", \"validation.npz\"):\n        previous_hashes[str((directory / filename).relative_to(PROJECT_ROOT))] = file_hash(\n            directory / filename\n        )\n\nhard_crack_ids = set(np.asarray(expected_ids)[common_misses].tolist())\nclean_crack_ids = {\n    region[\"image_id\"] for region in clean_val_regions if region[\"class_name\"] == \"crack\"\n}\nprint(\"Cracks missed by every previous model:\", len(hard_crack_ids))\nprint(\"Hard images with a clean crack anchor:\", len(hard_crack_ids & clean_crack_ids))\nprint(\"Hard images with overlapping anchors only:\", len(hard_crack_ids - clean_crack_ids))",
